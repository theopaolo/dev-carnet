---
// Pochette : la pochette au dos du carnet, en bas de la barre latérale et sur l'accueil.
// Le compte, les fiches qui dépassent et l'aperçu des rubans sont remplis par src/scripts/notebook.js
interface Props {
  peek?: boolean;
}
const { peek = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a class:list={["pocket-card", peek && "pocket-large"]} href={base + "/pochette/"}>
  <span class="pocket-slips" aria-hidden="true" data-pocket-slips></span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v5" /><path d="M3 9h6a3 3 0 0 0 6 0h6v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>
  <span class="pocket-name"><span class="arrow-next">Pochette</span></span>
  <span class="pocket-count" data-pocket-count>Vos rubans et vos notes, gardés dans ce navigateur</span>
  {peek && <ul class="pocket-peek" data-pocket-peek></ul>}
</a>

<style>
  /* Pochette d'un Leuchtturm : une feuille avec une encoche pour le pouce au milieu du bord haut.
     La feuille est un calque (::before) pour que les fiches rangées passent dessous : une fiche
     par ruban ou note, cinq au plus, qui dépassent du bord et se voient par l'encoche.
     --behind : la couleur autour de la carte, vue par l'encoche quand aucune fiche n'y passe */
  .pocket-card {
    --behind: var(--bg-desk);
    --paper: var(--bg-page);
    --edge: var(--border-strong);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2px 10px;
    padding: 16px 14px 12px;
    color: var(--text-muted);
    text-decoration: none;
    background: linear-gradient(var(--behind) 0 0) 50% 0 / 32px 16px no-repeat;
    border-radius: 8px;
    box-shadow: 0 1px 0 var(--pill-shadow);
  }

  .pocket-card::before,
  .pocket-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    border: 1px solid var(--edge);
    transition: border-color 0.15s ease;
  }

  .pocket-card::before {
    inset: 0;
    background: var(--paper);
    border-radius: 8px;
    mask: radial-gradient(circle 15px at 50% 0, transparent 14.5px, #000 15px);
  }

  /* Bord de l'encoche */
  .pocket-card::after {
    top: -1px;
    left: 50%;
    width: 30px;
    height: 16px;
    translate: -50% 0;
    border-top: 0;
    border-radius: 0 0 15px 15px;
  }

  .pocket-card:hover {
    --edge: var(--node-stroke);
  }

  .pocket-slips {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* Fiches en éventail, assez longues pour que leur bas reste dans la pochette une fois tournées.
     La deuxième couvre l'encoche : aucun bord de fiche n'y passe. Au survol, chacune remonte
     un peu, à son rythme */
  .pocket-slips :global(i) {
    position: absolute;
    top: calc(-1 * var(--peek));
    left: var(--x);
    width: var(--w);
    height: 44px;
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    rotate: var(--r);
    transition: translate 0.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0s);
  }

  .pocket-slips :global(i:nth-child(1)) { --x: 7%; --w: 36%; --r: -3deg; --peek: 9px; --lift: 5px; }
  .pocket-slips :global(i:nth-child(2)) { --x: 36%; --w: 30%; --r: 2deg; --peek: 7px; --lift: 7px; --delay: 0.04s; }
  .pocket-slips :global(i:nth-child(3)) { --x: 62%; --w: 30%; --r: -1.5deg; --peek: 11px; --lift: 4px; --delay: 0.08s; background: var(--bg-canvas); }
  .pocket-slips :global(i:nth-child(4)) { --x: 14%; --w: 26%; --r: 4deg; --peek: 5px; --lift: 8px; --delay: 0.02s; background: var(--bg-canvas); }
  .pocket-slips :global(i:nth-child(5)) { --x: 60%; --w: 26%; --r: -4deg; --peek: 4px; --lift: 6px; --delay: 0.06s; }

  .pocket-card:is(:hover, :focus-visible) .pocket-slips :global(i) {
    translate: 0 calc(-1 * var(--lift));
  }

  .pocket-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pocket-card svg {
    grid-row: span 3;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent-stroke);
  }

  .pocket-name {
    font-weight: 600;
    line-height: 1.25;
    color: var(--heading);
  }

  .pocket-count {
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  /* Accueil : sur le canevas pointillé, avec les rubans rangés */
  .pocket-large {
    --behind: var(--bg-canvas);
    --paper: var(--bg-surface);
    padding: 18px 16px 14px;
  }

  .pocket-peek {
    display: grid;
    gap: 4px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text);
  }

  .pocket-peek:empty {
    display: none;
  }

  /* Rangées remplies par le script : hors de la portée des styles scopés */
  .pocket-peek :global(li) {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    margin: 0;
  }

  .pocket-peek :global(li)::before {
    content: "";
    flex: none;
    width: 8px;
    height: 14px;
    background: var(--c);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% calc(100% - 3px), 0 100%);
  }

  .pocket-peek :global(span) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .pocket-card::before,
    .pocket-card::after,
    .pocket-slips :global(i) {
      transition: none;
    }
  }
</style>
