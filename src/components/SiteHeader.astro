---
import type { CollectionEntry } from "astro:content";
import { base, pageUrl } from "../lib/urls";
interface Props {
  course?: CollectionEntry<"cours">;
  showChapters?: boolean;
  navLabel: string;
}
const { course, showChapters = false, navLabel } = Astro.props;
---

<header class="topbar cluster" data-justify="between">
  <div class="where cluster">
    {course && (
      <>
        <a class="brand" href={base + "/"}>
          CarnetDeDev
        </a>
        <a class="where-course" href={pageUrl(course.id)}>
          {course.data.title}
        </a>
      </>
    )}
  </div>
  <div class="tools cluster">
    <button type="button" class="button search-open" aria-keyshortcuts="Control+K Meta+K /">
      Rechercher <kbd>/</kbd>
    </button>
    {showChapters && (
      <a class="button chapters-link" href="#chapitres">
        {navLabel}
      </a>
    )}
    <div class="size-btns cluster" role="group" aria-label="Taille du texte">
      <button type="button" class="button" data-size-step="-1" aria-label="A− réduire le texte">
        A−
      </button>
      <button type="button" class="button" data-size-step="1" aria-label="A+ agrandir le texte">
        A+
      </button>
    </div>
    <button
      type="button"
      class="button present-toggle"
      data-present-toggle
      aria-pressed="false"
      title="Masquer la barre latérale et le sommaire"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="3" />
        <path d="M3 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2" />
      </svg>
      Focus
    </button>
    <button
      type="button"
      class="button"
      data-theme-toggle
      aria-label="Changer de thème"
      title="Changer de thème"
    >
      <svg
        class="when-light"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
      <svg
        class="when-dark"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
  </div>
  <!-- Rubans posés, rendus par src/scripts/notebook.js -->
  <nav class="ribbons" aria-label="Rubans"></nav>
</header>
<script>
  import "../scripts/preferences.js";
</script>
