---
import type { MarkdownHeading } from "astro";
import { getCourses, intro } from "../lib/courses";
import { pageUrl } from "../lib/urls";
import PageHead from "../components/PageHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SearchDialog from "../components/SearchDialog.astro";
import CourseNavigation from "../components/CourseNavigation.astro";
import TableOfContents from "../components/TableOfContents.astro";
import "../styles/theme.css";

interface Props {
  title: string;
  id?: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { title, id = "", headings = [], description } = Astro.props;
const { all, courses, sheets } = await getCourses();
const page = all.find((entry) => entry.id === id);
const course = all.find((entry) => entry.id === id.split("/")[0]);
const group = courses.find((group) => group.course === course);
const navLabel = group ? "Chapitres" : "Fiches";
const toc = headings.filter((heading) => heading.depth <= 2);
const text = description ?? (intro(page?.body) || intro(course?.body));
const cutoff = text.lastIndexOf(" ", 199);
const summary = text.length > 200 ? text.slice(0, cutoff > 0 ? cutoff : 199) + "…" : text;
---

<!doctype html>
<html lang="fr">
  <head>
    <PageHead title={title} pageTitle={id ? `${title} | Carnet` : title} summary={summary} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <SiteHeader course={course} showChapters={!!id} navLabel={navLabel} />
    <SearchDialog courseUrl={course && pageUrl(course.id)} />
    <div class:list={["shell", !id && "shell-home"]}>
      {id && <CourseNavigation id={id} group={group} sheets={sheets} navLabel={navLabel} />}
      <div class="page">
        <main
          class:list={["content", id === "rgpd/01-reperes-ia-act-rgpd" && "legal-guide"]}
          id="contenu"
          tabindex="-1"
          data-page={id || undefined}
        >
          {toc.length > 0 && <TableOfContents headings={toc} inline />}
          <slot />
        </main>
        {toc.length > 0 && <TableOfContents headings={toc} />}
      </div>
    </div>
    <script>
      import "../scripts/lesson.js";
    </script>
  </body>
</html>
