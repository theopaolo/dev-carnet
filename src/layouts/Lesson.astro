---
import { getCollection } from "astro:content";
import "../styles/theme.css";

interface Props {
  title: string;
  id?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, id = "", headings = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toc = headings.filter((h) => h.depth <= 2);

// Barre latérale : un groupe par cours (index.md), ses chapitres dessous,
// replié sauf pour le cours en cours de lecture
const all = (await getCollection("cours", (c) => !c.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const groups = all
  .filter((c) => !c.id.includes("/"))
  .map((c) => ({
    course: c,
    chapters: all.filter((x) => x.id.startsWith(c.id + "/")).sort((a, b) => a.data.order - b.data.order),
  }));
const href = (i: string) => `${base}/${i}/`;
// Cours de la page affichée, rappelé dans la barre du haut
const course = id ? all.find((c) => c.id === id.split("/")[0]) : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{id ? `${title} | Carnet` : title}</title>
    <link rel="icon" href="data:," />
    <!-- Applique le thème et la taille mémorisés avant le premier rendu, pour éviter le flash -->
    <script is:inline>
      const read = (k) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const saved = read("theme");
      const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      const size = Number(read("textSize"));
      if (size >= -1 && size <= 3 && size !== 0) document.documentElement.dataset.size = size;
      // Projeter : pour la séance en cours seulement (sessionStorage)
      try {
        if (sessionStorage.getItem("present") === "1") document.documentElement.dataset.present = "";
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="topbar">
      <div class="where">
        <a class="brand" href={base + "/"}>Carnet</a>
        {course && <a class="where-course" href={href(course.id)}>{course.data.title}</a>}
      </div>
      <div class="tools">
        <button type="button" class="theme-toggle search-open" aria-keyshortcuts="Control+K Meta+K /">
          Rechercher <kbd>/</kbd>
        </button>
        <a class="theme-toggle chapters-link" href="#chapitres">Chapitres</a>
        <div class="size-btns" role="group" aria-label="Taille du texte">
          <button type="button" class="theme-toggle" data-size-step="-1" aria-label="A− réduire le texte">A−</button>
          <button type="button" class="theme-toggle" data-size-step="1" aria-label="A+ agrandir le texte">A+</button>
        </div>
        <button type="button" class="theme-toggle present-toggle" data-present-toggle aria-pressed="false">
          <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M232,64V48a16,16,0,0,0-16-16H40A16,16,0,0,0,24,48V64A16,16,0,0,0,40,80v96H32a8,8,0,0,0,0,16h88v17.38a24,24,0,1,0,16,0V192h88a8,8,0,0,0,0-16h-8V80A16,16,0,0,0,232,64ZM128,240a8,8,0,1,1,8-8A8,8,0,0,1,128,240ZM40,48H216V64H40ZM200,176H56V80H200Z"/></svg>
          Projeter
        </button>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Changer de thème" title="Changer de thème">
          <svg class="when-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="when-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>

    <dialog class="search" aria-label="Rechercher dans les cours" data-index={`${base}/search.json`}>
      <input type="search" placeholder="Rechercher dans les cours" aria-label="Rechercher" autocomplete="off" />
      <p class="search-status" role="status"></p>
      <ul class="search-results"></ul>
    </dialog>

    <!-- Téléphone : le bouton Chapitres ouvre une copie de la barre latérale -->
    <dialog class="chapters" aria-labelledby="chapters-title">
      <div class="chapters-head">
        <p class="chapters-title" id="chapters-title">Chapitres</p>
        <button type="button" class="theme-toggle" data-close>Fermer</button>
      </div>
    </dialog>

    <div class="shell">
      <nav class="sidebar" id="chapitres" aria-label="Cours">
        {groups.map(({ course, chapters }) =>
          chapters.length === 0 ? (
            <a class="nav-title" href={href(course.id)} aria-current={course.id === id ? "page" : undefined}>
              {course.data.title}
            </a>
          ) : (
            <details class="nav-group" open={id === course.id || id.startsWith(course.id + "/")}>
              <summary class="nav-title">{course.data.title}</summary>
              <ul>
                <li>
                  <a href={href(course.id)} aria-current={course.id === id ? "page" : undefined}>Présentation</a>
                </li>
                {chapters.map((c) => (
                  <li>
                    <a href={href(c.id)} aria-current={c.id === id ? "page" : undefined}>{c.data.title}</a>
                  </li>
                ))}
              </ul>
            </details>
          ),
        )}
      </nav>

      <main class="content" id="contenu" tabindex="-1">
        {toc.length > 0 && (
          <details class="toc-inline">
            <summary class="theme-toggle">Sur cette page</summary>
            <ul>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}
        <slot />
      </main>

      {toc.length > 0 && (
        <aside class="toc" aria-label="Sommaire">
          <p class="nav-title">Sommaire</p>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <script>
      import "../scripts/diagrams.js";
      import "../scripts/sequence.js";
      import "../scripts/reading.js";
      import "../scripts/search.js";
    </script>
    <script>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        document.dispatchEvent(new Event("themechange"));
      });

      // Projection : une colonne, sans barre latérale ni sommaire. Mémorisé d'un chapitre à l'autre
      const present = document.querySelector("[data-present-toggle]");
      const root = document.documentElement;
      present.setAttribute("aria-pressed", String("present" in root.dataset));
      present.addEventListener("click", () => {
        const on = !("present" in root.dataset);
        if (on) root.dataset.present = "";
        else delete root.dataset.present;
        present.setAttribute("aria-pressed", String(on));
        try {
          sessionStorage.setItem("present", on ? "1" : "0");
          localStorage.removeItem("present"); // ancienne mémorisation durable
        } catch {}
      });

      // Chapitres sur téléphone : la barre latérale est copiée dans un dialog au premier clic.
      // Sans JS, le lien descend à la barre latérale en bas de page.
      const chapters = document.querySelector("dialog.chapters");
      document.querySelector(".chapters-link")?.addEventListener("click", (e) => {
        e.preventDefault();
        if (!chapters.querySelector(".sidebar")) {
          const nav = document.querySelector(".sidebar").cloneNode(true);
          nav.removeAttribute("id");
          chapters.append(nav);
        }
        chapters.showModal();
      });
      chapters.querySelector("[data-close]").addEventListener("click", () => chapters.close());
      // Clic sur le fond, hors du contenu du dialog
      chapters.addEventListener("click", (e) => {
        if (e.target === chapters) chapters.close();
      });

      // Surligne l'entrée du sommaire dont le titre est à l'écran
      const toc = document.querySelector(".toc");
      const links = new Map(
        [...document.querySelectorAll(".toc a")].map((a) => [a.getAttribute("href").slice(1), a]),
      );
      const setActive = (id) => {
        const a = links.get(id);
        if (!a || a.classList.contains("active")) return;
        links.forEach((l) => l.classList.remove("active"));
        a.classList.add("active");
        // Un long sommaire défile dans sa colonne : l'entrée active reste visible
        if (a.offsetTop < toc.scrollTop || a.offsetTop + a.offsetHeight > toc.scrollTop + toc.clientHeight) {
          toc.scrollTop = a.offsetTop - toc.clientHeight / 2;
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
        },
        { rootMargin: "0px 0px -70% 0px" },
      );
      links.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
      // Les derniers titres n'atteignent jamais le haut de l'écran : en bas de page, la dernière entrée
      const lastId = [...links.keys()].at(-1);
      addEventListener(
        "scroll",
        () => {
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) setActive(lastId);
        },
        { passive: true },
      );
    </script>
  </body>
</html>

<style is:global>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 3.25rem;
    padding: 0 24px;
    background: var(--bg-page);
    border-bottom: 1px solid var(--border);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .size-btns {
    display: flex;
    gap: 4px;
  }

  .theme-toggle:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .search-open kbd {
    padding: 0 5px;
    font: 0.75rem "Roboto Mono", monospace;
    color: var(--text-muted);
    border: 1px solid var(--pill-border);
    border-radius: 4px;
  }

  .chapters-link {
    display: none !important;
    text-decoration: none;
  }

  /* Lien d'évitement : invisible jusqu'au premier Tab */
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 20;
    padding: 8px 14px;
    color: var(--heading);
    background: var(--bg-surface);
    border: 2px solid var(--accent);
    border-radius: 6px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .content:focus {
    outline: none;
  }

  .sidebar a:focus-visible,
  .toc a:focus-visible,
  .nav-title:focus-visible,
  .brand:focus-visible,
  .search-results a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Recherche */
  dialog.search {
    width: min(40rem, calc(100vw - 32px));
    max-height: min(36rem, calc(100vh - 96px));
    margin: 12vh auto 0;
    padding: 0;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  dialog.search::backdrop {
    background: rgba(10, 12, 18, 0.45);
  }

  dialog.search input {
    width: 100%;
    padding: 14px 16px;
    font: inherit;
    font-size: 1.0625rem;
    color: var(--heading);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    outline: none;
  }

  .search-status {
    margin: 0;
    padding: 6px 16px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0 8px 8px;
  }

  .search-results li {
    margin: 0;
  }

  .search-results a {
    display: grid;
    gap: 2px;
    padding: 10px 10px;
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    line-height: 1.45;
  }

  .search-results a:hover,
  .search-results a:focus-visible {
    background: var(--bg-canvas);
  }

  .search-page {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .search-section {
    font-weight: 600;
    color: var(--heading);
  }

  .search-snippet {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .search-results mark {
    color: inherit;
    background: var(--accent-fill);
    border-radius: 2px;
  }

  /* Chapitres (téléphone) : même cadre que la recherche */
  dialog.chapters {
    width: min(28rem, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    margin: 16px auto auto;
    padding: 0;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  dialog.chapters::backdrop {
    background: rgba(10, 12, 18, 0.45);
  }

  .chapters-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px 10px 20px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .chapters-title {
    margin: 0;
    font-weight: 600;
    color: var(--heading);
  }

  dialog.chapters .sidebar {
    padding: 12px;
    border: none;
    font-size: 1rem;
  }

  /* Cibles tactiles d'au moins 44px */
  dialog.chapters .sidebar a,
  dialog.chapters .nav-title {
    padding-block: 12px;
  }

  /* Sommaire dans le contenu, quand la colonne de droite n'est pas affichée */
  .toc-inline {
    display: none;
    margin: 0 0 28px;
    font-size: 0.9375rem;
  }

  .toc-inline summary {
    list-style: none;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  .toc-inline summary::before {
    content: "";
    width: 5px;
    height: 5px;
    margin-right: 2px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }

  .toc-inline[open] summary::before {
    transform: rotate(45deg);
  }

  .toc-inline ul {
    list-style: none;
    margin: 12px 0 0 4px;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc-inline li {
    margin: 0;
  }

  .toc-inline a {
    display: block;
    padding: 6px 12px;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc-inline li.depth-2 a {
    padding-left: 24px;
  }

  .toc-inline a:hover {
    color: var(--heading);
  }

  .toc-inline a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .where {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .brand {
    flex-shrink: 0;
    font-weight: 700;
    color: var(--heading);
    text-decoration: none;
  }

  .where-course {
    overflow: hidden;
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .where-course::before {
    content: "/";
    margin-right: 8px;
    color: var(--border-strong);
  }

  .where-course:hover {
    color: var(--heading);
  }

  .where-course:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Bouton enfoncé : mêmes couleurs que l'acteur actif des diagrammes animés */
  .present-toggle[aria-pressed="true"] {
    color: var(--accent-text);
    background: var(--accent-fill);
    border-color: var(--accent-stroke);
    box-shadow: 0 1px 0 var(--accent-shadow);
  }

  .tools .theme-toggle svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .theme-toggle .when-dark,
  [data-theme="dark"] .theme-toggle .when-light {
    display: none;
  }

  [data-theme="dark"] .theme-toggle .when-dark {
    display: block;
  }

  .shell {
    display: grid;
    /* 48rem : environ 80 caractères par ligne, quelle que soit la taille du texte */
    grid-template-columns: 14rem minmax(0, 48rem) 15rem;
    justify-content: center;
    gap: 48px;
    padding: 40px 24px 96px;
  }

  .content {
    min-width: 0;
  }

  .sidebar,
  .toc {
    position: sticky;
    top: 4.75rem;
    align-self: start;
    max-height: calc(100vh - 6.25rem);
    overflow-y: auto;
    font-size: 0.875rem;
  }

  .nav-title {
    display: block;
    margin: 0 0 6px;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--heading);
    text-decoration: none;
    cursor: pointer;
  }

  .nav-title:hover {
    background: var(--bg-canvas);
  }

  summary.nav-title {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  summary.nav-title::-webkit-details-marker {
    display: none;
  }

  /* Chevron qui pivote à l'ouverture */
  summary.nav-title::before {
    content: "";
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--text-muted);
    border-bottom: 1.5px solid var(--text-muted);
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  details[open] > summary.nav-title::before {
    transform: rotate(45deg);
  }

  .nav-group + .nav-group,
  .nav-title + .nav-group,
  .nav-group + .nav-title {
    margin-top: 12px;
  }

  .nav-group ul {
    border-left: 1px solid var(--border);
    margin-left: 4px;
  }

  .sidebar ul,
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar li,
  .toc li {
    margin: 0;
  }

  .sidebar a,
  .toc a {
    display: block;
    padding: 5px 10px;
    border-radius: 6px;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.4;
  }

  /* Cours sans chapitres : même couleur que les autres titres, texte aligné après les chevrons */
  .sidebar a.nav-title {
    padding-left: 24px;
    color: var(--heading);
  }

  .toc li.depth-2 a {
    padding-left: 22px;
  }

  .sidebar a:hover,
  .toc a:hover {
    color: var(--heading);
    background: var(--bg-canvas);
  }

  /* Position courante : couleurs de l'acteur actif des diagrammes, lisibles au projecteur */
  .sidebar a[aria-current="page"],
  .toc a.active {
    color: var(--accent-text);
    background: var(--accent-fill);
    box-shadow: inset 0 0 0 1px var(--accent-stroke);
    font-weight: 500;
  }

  .toc {
    border-left: 1px solid var(--border);
    padding-left: 12px;
  }

  @media (max-width: 1180px) {
    .shell {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
    .toc-inline {
      display: block;
    }
  }

  /* Texte agrandi (A+ 2 et 3) : les colonnes en px ne suivent pas la taille du texte,
     le sommaire disparaît pour laisser au moins 40rem au contenu */
  @media (min-width: 761px) {
    html[data-size="2"] .shell,
    html[data-size="3"] .shell {
      grid-template-columns: 14rem minmax(0, 48rem);
    }
    html[data-size="2"] .toc,
    html[data-size="3"] .toc {
      display: none;
    }
    html[data-size="2"] .toc-inline,
    html[data-size="3"] .toc-inline,
    html[data-present] .toc-inline {
      display: block;
    }

    /* Projection : une seule colonne. Le texte garde 48rem, les diagrammes prennent 72rem.
       Pas sur téléphone, où le bouton est caché et la barre latérale nécessaire */
    html[data-present] .sidebar,
    html[data-present] .toc {
      display: none;
    }
    html[data-present] .shell {
      grid-template-columns: minmax(0, 72rem);
    }
    html[data-present] .content > :not(.diagram) {
      max-width: 48rem;
      margin-inline: auto;
    }
    /* Diagrammes une fois et demie plus grands, un diagramme haut tient dans l'écran */
    html[data-present] div.mermaid > svg {
      max-width: calc(var(--w, 10000) * 0.09375rem);
      max-height: 80vh;
    }
  }

  @media (max-width: 760px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    /* Le contenu d'abord, les chapitres en bas de page (lien Chapitres dans la barre) */
    .sidebar {
      order: 2;
      position: static;
      max-height: none;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }
    .topbar {
      padding: 0 16px;
    }
    .chapters-link {
      display: inline-flex !important;
    }
    /* Boutons de la barre à 44px au doigt */
    .tools .theme-toggle {
      min-height: 44px;
    }
    .search-open kbd,
    .size-btns,
    .present-toggle {
      display: none;
    }
  }
</style>
