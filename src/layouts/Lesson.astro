---
import { getCourses, intro } from "../lib/courses";
import "../styles/theme.css";

interface Props {
  title: string;
  id?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, id = "", headings = [], description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const toc = headings.filter((h) => h.depth <= 2);
// L'accueil est lui-même la liste des cours : pas de barre latérale
const home = !id;

const { all, courses, sheets } = await getCourses();
const href = (i: string) => `${base}/${i}/`;
// Cours de la page affichée, rappelé dans la barre du haut
const course = id ? all.find((c) => c.id === id.split("/")[0]) : undefined;
// Barre latérale : les chapitres de ce cours seulement, ou la liste des fiches sur une fiche.
// Les autres cours restent sur l'accueil, à un clic, sans distraire la lecture
const group = courses.find((g) => g.course === course);
const navLabel = group ? "Chapitres" : "Fiches";
// Aperçu d'un lien collé dans Discord, Slack ou Teams : le premier paragraphe de la page,
// sinon celui du cours, coupé au dernier mot avant 200 caractères. Pas d'image : Carnet n'en a pas
const text = description ?? (intro(all.find((c) => c.id === id)?.body) || intro(course?.body));
const summary = text.length > 200 ? text.slice(0, text.lastIndexOf(" ", 199)) + "…" : text;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{id ? `${title} | Carnet` : title}</title>
    {summary && <meta name="description" content={summary} />}
    <meta property="og:site_name" content="Carnet" />
    <meta property="og:title" content={title} />
    {summary && <meta property="og:description" content={summary} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <link rel="icon" href="data:," />
    <!-- Applique le thème et la taille mémorisés avant le premier rendu, pour éviter le flash -->
    <script is:inline>
      const read = (k) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const saved = read("theme");
      const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = dark ? "dark" : "light";
      const size = Number(read("textSize"));
      if (size >= -1 && size <= 3 && size !== 0) document.documentElement.dataset.size = size;
      // Focus : pour la séance en cours seulement (sessionStorage)
      try {
        if (sessionStorage.getItem("present") === "1") document.documentElement.dataset.present = "";
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="topbar">
      <div class="where">
        <a class="brand" href={base + "/"}>Carnet</a>
        {course && <a class="where-course" href={href(course.id)}>{course.data.title}</a>}
      </div>
      <div class="tools">
        <button type="button" class="theme-toggle search-open" aria-keyshortcuts="Control+K Meta+K /">
          Rechercher <kbd>/</kbd>
        </button>
        {!home && <a class="theme-toggle chapters-link" href="#chapitres">{navLabel}</a>}
        <div class="size-btns" role="group" aria-label="Taille du texte">
          <button type="button" class="theme-toggle" data-size-step="-1" aria-label="A− réduire le texte">A−</button>
          <button type="button" class="theme-toggle" data-size-step="1" aria-label="A+ agrandir le texte">A+</button>
        </div>
        <button type="button" class="theme-toggle present-toggle" data-present-toggle aria-pressed="false" title="Masquer la barre latérale et le sommaire">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M3 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/></svg>
          Focus
        </button>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Changer de thème" title="Changer de thème">
          <svg class="when-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="when-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>

    <dialog
      class="search"
      aria-label="Rechercher dans les cours"
      data-index={`${base}/search.json`}
      data-course={course && href(course.id)}
    >
      <input type="search" placeholder="Rechercher dans les cours" aria-label="Rechercher" autocomplete="off" />
      <p class="search-status" role="status"></p>
      <ul class="search-results"></ul>
    </dialog>

    <!-- Téléphone : le bouton Chapitres ouvre une copie de la barre latérale -->
    <dialog class="chapters" aria-labelledby="chapters-title">
      <div class="chapters-head">
        <p class="chapters-title" id="chapters-title">{navLabel}</p>
        <button type="button" class="theme-toggle" data-close>Fermer</button>
      </div>
    </dialog>

    <div class:list={["shell", home && "shell-home"]}>
      {!home && (
        <nav class="sidebar" id="chapitres" aria-label="Cours">
          <a class="nav-back arrow-prev" href={base + "/"}>Tous les cours</a>
          {group ? (
            <>
              <p class="nav-title">{group.course.data.title}</p>
              <ul class="nav-chapters">
                <li>
                  <a href={href(group.course.id)} aria-current={group.course.id === id ? "page" : undefined}>Présentation</a>
                </li>
                {group.chapters.map((c) => (
                  <li>
                    <a href={href(c.id)} aria-current={c.id === id ? "page" : undefined}>{c.data.title}</a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <>
              <p class="nav-section">Fiches</p>
              <ul>
                {sheets.map(({ course }) => (
                  <li>
                    <a class="nav-title" href={href(course.id)} aria-current={course.id === id ? "page" : undefined}>
                      {course.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </nav>
      )}

      <div class="page">
        <main
          class:list={["content", id === "rgpd/01-reperes-ia-act-rgpd" && "legal-guide"]}
          id="contenu"
          tabindex="-1"
          data-page={id || undefined}
        >
          {toc.length > 0 && (
            <details class="toc-inline">
              <summary class="theme-toggle">Sur cette page</summary>
              <ul>
                {toc.map((h) => (
                  <li class={`depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <slot />
        </main>

        {toc.length > 0 && (
          <aside class="toc" aria-label="Sommaire">
            <p class="nav-section">Sommaire</p>
            <ul>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </div>

    <script>
      import "../scripts/diagrams.js";
      import "../scripts/sequence.js";
      import "../scripts/reading.js";
      import "../scripts/search.js";
    </script>
    <script>
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        document.dispatchEvent(new Event("themechange"));
      });

      // Focus : une colonne, sans barre latérale ni sommaire, pour lire ou projeter. Mémorisé d'un chapitre à l'autre
      const present = document.querySelector("[data-present-toggle]");
      const root = document.documentElement;
      present.setAttribute("aria-pressed", String("present" in root.dataset));
      present.addEventListener("click", () => {
        const on = !("present" in root.dataset);
        if (on) root.dataset.present = "";
        else delete root.dataset.present;
        present.setAttribute("aria-pressed", String(on));
        try {
          sessionStorage.setItem("present", on ? "1" : "0");
          localStorage.removeItem("present"); // ancienne mémorisation durable
        } catch {}
      });

      // Chapitres sur téléphone : la barre latérale est copiée dans un dialog au premier clic.
      // Sans JS, le lien descend à la barre latérale en bas de page.
      const chapters = document.querySelector("dialog.chapters");
      document.querySelector(".chapters-link")?.addEventListener("click", (e) => {
        e.preventDefault();
        if (!chapters.querySelector(".sidebar")) {
          const nav = document.querySelector(".sidebar").cloneNode(true);
          nav.removeAttribute("id");
          chapters.append(nav);
        }
        chapters.showModal();
        chapters.querySelector('[aria-current="page"]')?.scrollIntoView({ block: "center" });
      });

      // Barre latérale : l'entrée de la page affichée est visible sans avoir à la chercher
      const nav = document.querySelector(".shell > .sidebar");
      const here = nav?.querySelector('[aria-current="page"]');
      if (here && here.offsetTop + here.offsetHeight > nav.clientHeight) {
        nav.scrollTop = here.offsetTop - nav.clientHeight / 3;
      }
      chapters.querySelector("[data-close]").addEventListener("click", () => chapters.close());
      // Clic sur le fond, hors du contenu du dialog
      chapters.addEventListener("click", (e) => {
        if (e.target === chapters) chapters.close();
      });

      // Reprendre : la dernière page lue et sa section, relues par le lien de l'accueil.
      // Rien ne quitte le navigateur
      const pageId = document.getElementById("contenu").dataset.page;
      const remember = (section) => {
        if (!pageId) return;
        try {
          localStorage.setItem("resume", JSON.stringify({ id: pageId, ...section }));
        } catch {}
      };
      remember();

      // Surligne l'entrée du sommaire dont le titre est à l'écran
      const toc = document.querySelector(".toc");
      const links = new Map(
        [...document.querySelectorAll(".toc a")].map((a) => [a.getAttribute("href").slice(1), a]),
      );
      const setActive = (id) => {
        const a = links.get(id);
        if (!a || a.classList.contains("active")) return;
        links.forEach((l) => l.classList.remove("active"));
        a.classList.add("active");
        // Le titre de la page (depth-1) ramène en haut : pas de section à retenir
        remember(a.parentElement.classList.contains("depth-2") ? { slug: id, section: a.textContent } : undefined);
        // Un long sommaire défile dans sa colonne : l'entrée active reste visible
        if (a.offsetTop < toc.scrollTop || a.offsetTop + a.offsetHeight > toc.scrollTop + toc.clientHeight) {
          toc.scrollTop = a.offsetTop - toc.clientHeight / 2;
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
        },
        { rootMargin: "0px 0px -70% 0px" },
      );
      links.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
      // Les derniers titres n'atteignent jamais le haut de l'écran : en bas de page, la dernière entrée
      const lastId = [...links.keys()].at(-1);
      addEventListener(
        "scroll",
        () => {
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) setActive(lastId);
        },
        { passive: true },
      );
    </script>
  </body>
</html>

<style is:global>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 3.25rem;
    padding: 0 24px;
    background: var(--bg-desk);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .size-btns {
    display: flex;
    gap: 4px;
  }

  .theme-toggle:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .search-open kbd {
    padding: 0 5px;
    font: 0.75rem "Roboto Mono", monospace;
    color: var(--text-muted);
    border: 1px solid var(--pill-border);
    border-radius: 4px;
  }

  .chapters-link {
    display: none !important;
    text-decoration: none;
  }

  /* Lien d'évitement : invisible jusqu'au premier Tab */
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 20;
    padding: 8px 14px;
    color: var(--heading);
    background: var(--bg-surface);
    border: 2px solid var(--accent);
    border-radius: 6px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .content:focus {
    outline: none;
  }

  .sidebar a:focus-visible,
  .toc a:focus-visible,
  .brand:focus-visible,
  .search-results a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Recherche */
  dialog.search {
    width: min(40rem, calc(100vw - 32px));
    max-height: min(36rem, calc(100vh - 96px));
    margin: 12vh auto 0;
    padding: 0;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  dialog.search::backdrop {
    background: rgba(10, 12, 18, 0.45);
  }

  dialog.search input {
    width: 100%;
    padding: 14px 16px;
    font: inherit;
    font-size: 1.0625rem;
    color: var(--heading);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    outline: none;
  }

  .search-status {
    margin: 0;
    padding: 6px 16px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0 8px 8px;
  }

  .search-results li {
    margin: 0;
  }

  .search-results a {
    display: grid;
    gap: 2px;
    padding: 10px 10px;
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    line-height: 1.45;
  }

  .search-results a:hover,
  .search-results a:focus-visible {
    background: var(--bg-canvas);
  }

  .search-page {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .search-section {
    font-weight: 600;
    color: var(--heading);
  }

  .search-snippet {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .search-results mark {
    color: inherit;
    background: var(--accent-fill);
    border-radius: 2px;
  }

  /* Chapitres (téléphone) : même cadre que la recherche */
  dialog.chapters {
    width: min(28rem, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    margin: 16px auto auto;
    padding: 0;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
  }

  dialog.chapters::backdrop {
    background: rgba(10, 12, 18, 0.45);
  }

  .chapters-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px 10px 20px;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .chapters-title {
    margin: 0;
    font-weight: 600;
    color: var(--heading);
  }

  dialog.chapters .sidebar {
    position: static;
    height: auto;
    overflow: visible;
    padding: 16px 12px 24px;
    background: none;
    border: none;
    font-size: 1rem;
  }

  /* Cibles tactiles d'au moins 44px */
  dialog.chapters .sidebar a {
    padding-block: 12px;
  }

  /* Sommaire dans le contenu, quand la colonne de droite n'est pas affichée */
  .toc-inline {
    display: none;
    margin: 0 0 28px;
    font-size: 0.9375rem;
  }

  .toc-inline summary {
    list-style: none;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  .toc-inline summary::before {
    content: "";
    width: 5px;
    height: 5px;
    margin-right: 2px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }

  .toc-inline[open] summary::before {
    transform: rotate(45deg);
  }

  .toc-inline ul {
    list-style: none;
    margin: 12px 0 0 4px;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc-inline li {
    margin: 0;
  }

  .toc-inline a {
    display: block;
    padding: 6px 12px;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc-inline li.depth-2 a {
    padding-left: 24px;
  }

  .toc-inline a:hover {
    color: var(--heading);
  }

  .toc-inline a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .where {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .brand {
    flex-shrink: 0;
    font-weight: 700;
    color: var(--heading);
    text-decoration: none;
  }

  .where-course {
    overflow: hidden;
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .where-course::before {
    content: "/";
    margin-right: 8px;
    color: var(--border-strong);
  }

  .where-course:hover {
    color: var(--heading);
  }

  .where-course:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Bouton enfoncé : mêmes couleurs que l'acteur actif des diagrammes animés */
  .present-toggle[aria-pressed="true"] {
    color: var(--accent-text);
    background: var(--accent-fill);
    border-color: var(--accent-stroke);
    box-shadow: 0 1px 0 var(--accent-shadow);
  }

  .tools .theme-toggle svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .theme-toggle .when-dark,
  [data-theme="dark"] .theme-toggle .when-light {
    display: none;
  }

  [data-theme="dark"] .theme-toggle .when-dark {
    display: block;
  }

  .wrap {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 32px;
  }

  /* Accueil et page 404 : en-tête posé sur le canevas pointillé des diagrammes */
  .hero {
    padding: 72px 0 64px;
    background-color: var(--bg-canvas);
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: 12px 12px;
    border-bottom: 1px solid var(--border);
  }

  .hero h1 {
    margin: 0 0 12px;
    padding: 0;
    border: 0;
    font-size: clamp(2.75rem, 2rem + 3vw, 4rem);
    line-height: 1.05;
  }

  .lede {
    max-width: 34rem;
    margin: 0 0 32px;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Grand champ de recherche : ouvre la même fenêtre que le bouton de la barre du haut */
  .hero-search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(100%, 34rem);
    padding: 12px 14px;
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-align: left;
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    box-shadow: 0 1px 0 var(--pill-shadow);
    cursor: text;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero-search:hover {
    color: var(--heading);
    border-color: var(--node-stroke);
  }

  .hero-search:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hero-search svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .hero-search kbd {
    margin-left: auto;
  }

  /* Coque : la barre latérale occupe le bord gauche sur toute la hauteur,
     le contenu et le sommaire sont centrés dans le reste */
  .shell {
    display: grid;
    grid-template-columns: 18rem minmax(0, 1fr);
  }

  .page {
    display: grid;
    /* 48rem : environ 80 caractères par ligne, quelle que soit la taille du texte */
    grid-template-columns: minmax(0, 48rem) 15rem;
    justify-content: center;
    gap: 48px;
    min-width: 0;
    padding: 40px 32px 96px;
    /* Feuille du carnet : papier ivoire aux coins arrondis, posée sur le bureau */
    margin: 0 16px 16px 0;
    background: var(--bg-page);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  /* Accueil : une colonne pleine largeur, la page gère ses marges */
  .shell-home {
    display: block;
  }

  .shell-home .page {
    display: block;
    position: relative;
    margin-left: 16px;
    padding: 0 0 96px;
    /* L'en-tête pointillé suit les coins arrondis */
    overflow: clip;
  }

  /* Élastique du carnet, sur toute la hauteur de l'accueil. Au milieu de la marge droite,
     seulement quand la marge est assez large pour ne pas toucher le texte */
  @media (min-width: 82rem) {
    .shell-home .page::after {
      content: "";
      position: absolute;
      inset: 0 calc(25% - 18rem - 10px) 0 auto;
      width: 20px;
      /* Trame du tissu : une ligne plus sombre tous les 3px, bords tissés plus foncés */
      background: repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.16) 2px 3px) var(--accent-stroke);
      box-shadow:
        inset 2px 0 rgb(0 0 0 / 0.14),
        inset -2px 0 rgb(0 0 0 / 0.14),
