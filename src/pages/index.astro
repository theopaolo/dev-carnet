---
import { getCollection } from "astro:content";
import Lesson from "../layouts/Lesson.astro";

const all = await getCollection("cours", (c) => !c.data.hidden);
const cours = all.filter((c) => !c.id.includes("/")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Présentation d'un cours : premier paragraphe de texte de son index.md, sans balisage Markdown
const intro = (body = "") => {
  const para = body
    .split(/\n\s*\n/)
    .map((b) => b.trim())
    .find((b) => b && !/^(#|>|-|\*|\d+\.|```|\||!\[|<)/.test(b));
  return (para ?? "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*`]/g, "")
    .replace(/\s+/g, " ");
};
const chapters = (id: string) => all.filter((x) => x.id.startsWith(id + "/")).length;
---

<Lesson title="Carnet">
  <h1>Carnet</h1>
  <p class="lede">Des cours de programmation, à relire après la séance ou à projeter en classe.</p>
  <ul class="courses">
    {cours.map((c) => {
      const n = chapters(c.id);
      return (
        <li>
          <h2>
            <a href={`${base}/${c.id}/`}>{c.data.title}</a>
          </h2>
          <p>{intro(c.body)}</p>
          <span class="count">{n > 0 ? `${n} chapitres` : "Une page"}</span>
        </li>
      );
    })}
  </ul>
</Lesson>

<style>
  .lede {
    color: var(--text-muted);
  }

  .courses {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .courses li {
    margin: 0;
    padding: 20px 0 22px;
    border-top: 1px solid var(--border);
  }

  .courses h2 {
    margin: 0 0 6px;
    font-size: 1.25rem;
  }

  .courses h2 a {
    text-decoration: none;
  }

  .courses h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .courses h2 a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .courses p {
    margin: 0 0 10px;
    color: var(--text-muted);
  }

  /* Même étiquette que « Fig. 1 » sous les diagrammes */
  .count {
    font-family: "Roboto Mono", monospace;
    font-size: 0.75rem;
    color: var(--pill-text);
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    border-radius: 4px;
    padding: 1px 6px;
  }
</style>
